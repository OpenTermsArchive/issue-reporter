# Open Terms Archive Issue Reporter - Environment Variables Example
# Copy this file to .env and fill in your actual values

OTA_ISSUE_REPORTER_GITHUB_TOKEN=your_github_token_here
OTA_ISSUE_REPORTER_GITLAB_TOKEN=your_gitlab_token_here
OTA_ISSUE_REPORTER_SMTP_PASSWORD=your_smtp_password_here

HTTP_PROXY=http://proxy.example.com:8080
HTTPS_PROXY=https://proxy.example.com:8080
